# Copie este arquivo pra ".env.local" (NÃO commitar o .env.local — já está no .gitignore)
# e preencha com os valores reais. Na Vercel, as mesmas chaves vão em
# Project Settings > Environment Variables.

# Supabase (o MESMO projeto do DirectGov, do agendador-stories, do Chatbot Direct e do
# ShoppingHub — só as tabelas são novas, prefixo smartads_)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública (Publishable key, sb_publishable_...) do MESMO projeto Supabase acima — usada só
# pro login do painel administrativo (Supabase Auth), nunca pra acessar o banco direto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------------------------
# Meta Marketing API — integração DIRETA (sem Windsor.ai nem nenhum intermediário pago).
# ---------------------------------------------------------------------------------------------

# ID e chave secreta do App criado em developers.facebook.com, do tipo "Negócios". Em
# Configurações do app > Básico. Usado só pra login (OAuth) e pra renovar o token depois — nunca
# passa pelo App Review da Meta, porque quem autoriza é sempre o próprio dono da agência (não um
# terceiro de fora), e o app fica em modo Desenvolvimento pra sempre.
#
# Em Configurações do app > Login do Facebook > Configurações, adicione a URI de redirecionamento
# válida: <NEXT_PUBLIC_APP_URL>/api/auth/meta/callback (ex: https://smartads.vercel.app/api/auth/
# meta/callback). Em Funções > Funções, garanta que o seu próprio usuário Meta está como Admin do
# app (senão o login falha com "app em modo de desenvolvimento").
META_APP_ID=
META_APP_SECRET=

# Apps "Negócios" usam o produto "Login do Facebook para Empresas", que não aceita mais lista de
# permissões direto na URL de login — as permissões (Anúncios, Páginas, Instagram etc.) ficam
# definidas numa "Configuração de Login" criada dentro do app (Configurações do app > Login do
# Facebook para Empresas > Configurações > Criar configuração), e o login usa o ID dela aqui.
# Sem essa variável, o botão "Conectar Meta" simplesmente devolve o usuário pro feed do Facebook,
# sem erro nenhum (achado em 12/09/2026 testando em produção).
META_LOGIN_CONFIG_ID=

# NÃO existe token fixo aqui — diferente de outras integrações, a conexão com a Meta é feita
# LOGANDO com Facebook uma única vez dentro do próprio SmartAds (botão "Conectar Meta" na tela de
# contas). Isso gera um token de usuário de longa duração (60 dias) que o app guarda no Supabase
# (tabela smartads_meta_status) e renova sozinho antes de vencer — sem precisar logar de novo, a
# não ser que a renovação automática falhe (aí o painel avisa "reconectar").
#
# Por que login em vez de token fixo de Usuário do Sistema: seu acesso às contas dos clientes vem
# do SEU usuário pessoal sendo admin em várias Business Managers diferentes e separadas (uma por
# cliente) — não de um Business Manager único da agência com tudo compartilhado nele. Um token de
# Usuário do Sistema só enxergaria os ativos de UMA Business Manager. O login com o seu usuário
# pessoal enxerga tudo que você já tem acesso, exatamente como no Gerenciador de Anúncios.

# Versão da Graph API usada em todas as chamadas (ex: v21.0). Sem essa variável, o código usa a
# versão mais recente estável conhecida por padrão — só preencher se precisar fixar uma versão
# específica.
META_API_VERSION=

NEXT_PUBLIC_APP_URL=

# Segredo pra proteger endpoints de cron (ex: verificação periódica de status da conexão com a
# Meta) — a Vercel manda esse valor automaticamente no header "Authorization: Bearer" das chamadas
# de cron; o código confere esse valor pra ninguém mais conseguir disparar manualmente batendo na
# URL.
CRON_SECRET=

# ---------------------------------------------------------------------------------------------
# Gemini (Google) — mesma chave já usada no chatbot-direct, é o MESMO Google AI Studio, só
# reaproveitar. Usado pros recursos de IA (resumo em português, sugestão de interesses etc.).
# ---------------------------------------------------------------------------------------------
GEMINI_API_KEY=

# Modelo mais leve por padrão de propósito (menos token gasto por chamada) — os recursos de IA
# daqui são resumos curtos, não uma conversa longa como o chatbot; não precisa do modelo mais
# caro. Configurável sem mexer em código, só trocando essa variável na Vercel.
GEMINI_MODEL=gemini-2.0-flash-lite
